#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

# Skip if it's a merge commit
if [ "$COMMIT_SOURCE" = "merge" ]; then
  exit 0
fi

BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null)
AUTHOR_NAME=$(git config user.name)

# Only append if we got a branch name
if [ -n "$BRANCH_NAME" ]; then
  # Check if we already added it (to avoid duplicates if someone edits the commit message again)
  if ! grep -q "\[Branch: $BRANCH_NAME\]" "$COMMIT_MSG_FILE"; then
    echo "" >> "$COMMIT_MSG_FILE"
    echo "---" >> "$COMMIT_MSG_FILE"
    echo "👤 Author: $AUTHOR_NAME" >> "$COMMIT_MSG_FILE"
    echo "🌿 Branch: $BRANCH_NAME" >> "$COMMIT_MSG_FILE"
    echo "🕒 Date: $(date "+%Y-%m-%d %H:%M:%S")" >> "$COMMIT_MSG_FILE"
  fi
fi
